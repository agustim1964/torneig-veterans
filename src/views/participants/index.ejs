<%- include('../partials/header', { title: category.nom }) %>

<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <a href="/categories" class="text-decoration-none">← Categories</a>
    <h1 class="mt-2"><%= category.nom %></h1>
    <% if (category.format_competicio === 'GRUP_UNIC') { %>
      <span class="badge text-bg-info">Grup únic · sense fase final</span>
    <% } %>
  </div>
  <a class="btn btn-outline-primary" href="/groups/category/<%= category.idcategoria %>">
    Veure grups
  </a>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <% if (importSummary && importSummary.imported > 0) { %>
      <div class="alert alert-success">
        S'han importat <strong><%= importSummary.imported %></strong> participants.
        <% if (importSummary.inactive > 0) { %>
          <strong><%= importSummary.inactive %></strong> han quedat inactius i no entraran al sorteig.
        <% } %>
      </div>
    <% } %>
    <div class="card shadow-sm">
      <div class="card-header">Participants</div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>Rànquing</th>
              <th style="min-width:360px; width:100%">Participant</th>
              <th>País</th>
              <th>Data naixement</th>
              <th>Estat</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
          <% participants.forEach(p => { %>
            <tr class="<%= p.actiu ? '' : 'table-light text-muted' %>">
              <td class="text-end"><%= p.ranking %></td>
              <td style="min-width:360px; width:100%"><%= p.nom_mostrar %></td>
              <td><%= p.pais || '—' %></td>
              <td class="text-nowrap"><%= p.data_naixement || '—' %></td>
              <td>
                <% if (p.actiu && !p.baixa) { %>
                  <span class="badge text-bg-success">Actiu</span>
                <% } else { %>
                  <span class="badge text-bg-secondary">Inactiu</span>
                <% } %>
              </td>
              <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-primary"
                   href="/participants/<%= p.idparticipant %>/edit">Editar</a>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow-sm mb-4">
      <div class="card-header">Afegir participant</div>
      <div class="card-body">
        <p class="small text-muted">
          L'alta crea la fitxa del jugador i la vincula amb el participant de la categoria.
        </p>
        <a class="btn btn-primary w-100"
           href="/participants/category/<%= category.idcategoria %>/new">
          Nou participant
        </a>
      </div>
    </div>

    <div class="card shadow-sm mb-4">
      <div class="card-header">Importar Excel / CSV</div>
      <div class="card-body">
        <p class="small text-muted">
          Columnes admeses: <strong>nom</strong>, <strong>cognoms</strong>,
          <strong>club</strong>, <strong>pais</strong>, <strong>sexe</strong>,
          <strong>llicencia</strong>, <strong>ranking</strong>,
          <strong>data_naixement</strong> i <strong>actiu</strong>.
          La data pot ser una data d'Excel, dd/mm/aaaa o aaaa-mm-dd.
          Per a actiu s'accepta 1/0, sí/no o actiu/inactiu.
        </p>
        <form action="/participants/category/<%= category.idcategoria %>/import" method="post" enctype="multipart/form-data">
          <input class="form-control mb-3" type="file" name="fitxer" accept=".xlsx,.csv" required>
          <button class="btn btn-outline-primary w-100">Importar</button>
        </form>
      </div>
    </div>

    <div class="card shadow-sm border-primary">
      <div class="card-header">Sorteig</div>
      <div class="card-body">
        <p class="small text-muted">
          Els caps de sèrie van directament per rànquing. Dins dels blocs 2×2 o 4×4 el programa intenta evitar coincidències de club i, després, de país.
        </p>
        <div class="d-grid gap-2">
          <form action="/groups/category/<%= category.idcategoria %>/draw" method="post"
                onsubmit="return confirm('Esborrar el sorteig actual i generar-lo de nou amb serp 2x2?')">
            <input type="hidden" name="snakeBlockSize" value="2">
            <button class="btn btn-outline-primary w-100">Sorteig serp 2 × 2</button>
          </form>
          <form action="/groups/category/<%= category.idcategoria %>/draw" method="post"
                onsubmit="return confirm('Esborrar el sorteig actual i generar-lo de nou amb serp 4x4?')">
            <input type="hidden" name="snakeBlockSize" value="4">
            <button class="btn btn-primary w-100">Sorteig serp 4 × 4</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
