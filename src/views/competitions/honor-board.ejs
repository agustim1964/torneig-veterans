<!doctype html>
<html lang="ca"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Quadre d'honor · <%= competition.nom %></title>
<style>
@page{size:A4 portrait;margin:9mm}*{box-sizing:border-box}body{margin:0;color:#172033;font-family:Arial,sans-serif;background:#eef1f6}.controls{max-width:192mm;margin:12px auto;padding:10px 12px;background:#fff;border:1px solid #ccd3df;border-radius:8px}.controls button{padding:7px 14px;cursor:pointer}.page{width:192mm;min-height:279mm;margin:0 auto 10mm;padding:8mm;background:#fff;page-break-after:always}.page:last-child{page-break-after:auto}.event-header{display:flex;justify-content:space-between;align-items:flex-end;border-bottom:1.2mm solid #d6a40b;padding-bottom:3mm;margin-bottom:6mm}.event-header h1{margin:0;font-size:24pt;color:#10254a}.event-header p{margin:1mm 0 0;font-size:10pt}.event-meta{text-align:right;font-size:9pt;color:#536078}.category{min-height:119mm;border:.35mm solid #bcc6d7;border-radius:3mm;padding:5mm;margin-bottom:6mm;break-inside:avoid;position:relative;overflow:hidden}.category:after{content:'';position:absolute;width:45mm;height:45mm;right:-22mm;top:-23mm;border-radius:50%;background:#f4c430;opacity:.18}.category-name{margin:0 0 4mm;font-size:20pt;color:#10254a}.podiums{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(0,1fr);gap:5mm;align-items:start}.podium{border-radius:2.5mm;overflow:hidden}.podium-a{border:.6mm solid #d6a40b;box-shadow:0 1.5mm 4mm #10254a1f}.podium-b{border:.35mm solid #9aa7ba;margin-top:5mm}.podium-title{display:flex;justify-content:space-between;align-items:center;padding:2.2mm 3mm;font-weight:700}.podium-a .podium-title{background:#10254a;color:#fff;font-size:13pt}.podium-b .podium-title{background:#e9edf3;color:#33415c;font-size:10pt}.badge{padding:.6mm 1.5mm;border-radius:1mm;background:#f4c430;color:#10254a;font-size:8pt}.places{padding:2mm;background:#fff}.place{display:grid;grid-template-columns:13mm 1fr;gap:2mm;align-items:center;border-bottom:.25mm solid #e1e5ec;padding:2.2mm 1.5mm}.place:last-child{border-bottom:0}.podium-a .place:first-child{min-height:17mm;background:linear-gradient(90deg,#fff7d1,#fff)}.podium-a .place:first-child .name{font-size:13pt;font-weight:700}.podium-b .place{padding-top:1.5mm;padding-bottom:1.5mm}.rank{font-weight:800;color:#10254a;text-align:center}.podium-a .rank{font-size:12pt}.podium-b .rank,.podium-b .name{font-size:8.5pt}.name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.country{color:#6c778c;font-size:7.5pt;margin-left:1mm}.pending{color:#a3aab6;font-style:italic}@media print{body{background:#fff;print-color-adjust:exact;-webkit-print-color-adjust:exact}.controls{display:none}.page{margin:0;width:auto;min-height:0}}
</style></head><body>
<div class="controls"><button onclick="window.print()">Imprimir quadre d'honor</button><span style="margin-left:10px"><%= honor.length %> categories · 2 per pàgina</span></div>
<% const places = podium => podium ? [{r:'1r',p:podium.winner},{r:'2n',p:podium.runnerUp},{r:'3r',p:podium.thirds[0]},{r:'3r',p:podium.thirds[1]}] : []; %>
<% for(let i=0;i<honor.length;i+=2){ %><main class="page">
<header class="event-header"><div><h1>Quadre d'honor</h1><p><%= competition.nom %></p></div><div class="event-meta"><div><%= competition.lloc||'' %></div><div><%= competition.data_inici?new Date(competition.data_inici).toLocaleDateString('ca-ES',{timeZone:'UTC'}):'' %></div></div></header>
<% honor.slice(i,i+2).forEach(category=>{ const main=places(category.main), consolation=places(category.consolation); %>
<section class="category"><h2 class="category-name"><%= category.name %></h2><div class="podiums">
<div class="podium podium-a"><div class="podium-title"><span>Quadre A</span><span class="badge">PRINCIPAL</span></div><div class="places">
<% if(main.length){main.forEach(x=>{ %><div class="place"><div class="rank"><%= x.r %></div><div class="name <%= x.p?'':'pending' %>"><%= x.p?x.p.name:'Pendent' %><% if(x.p?.country){ %><span class="country"><%= x.p.country %></span><% } %></div></div><% })}else{ %><div class="place pending">Quadre no disponible</div><% } %>
</div></div>
<div class="podium podium-b"><div class="podium-title"><span>Quadre B</span><span>Consolació</span></div><div class="places">
<% if(consolation.length){consolation.forEach(x=>{ %><div class="place"><div class="rank"><%= x.r %></div><div class="name <%= x.p?'':'pending' %>"><%= x.p?x.p.name:'Pendent' %><% if(x.p?.country){ %><span class="country"><%= x.p.country %></span><% } %></div></div><% })}else{ %><div class="place pending">Quadre no disponible</div><% } %>
</div></div></div></section><% }) %></main><% } %>
</body></html>
