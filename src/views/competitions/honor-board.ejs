<!doctype html>
<% const viewLocale = typeof locale !== 'undefined' ? locale : 'ca';
   const tr = typeof t !== 'undefined' ? t : key => key; %>
<html lang="<%= viewLocale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= tr('honorBoard') %> · <%= competition.nom %></title>
  <style>
    @page { size: A4 portrait; margin: 9mm; }
    * { box-sizing: border-box; }
    body { margin: 0; color: #172033; font-family: Arial, Helvetica, sans-serif; background: #eef1f6; }
    .controls { max-width: 192mm; margin: 12px auto; padding: 10px 12px; background: #fff; border: 1px solid #ccd3df; border-radius: 8px; }
    .controls button { padding: 7px 14px; cursor: pointer; }
    .page { width: 192mm; min-height: 279mm; margin: 0 auto 10mm; padding: 8mm; background: #fff; page-break-after: always; }
    .page:last-child { page-break-after: auto; }
    .event-header { display: flex; justify-content: space-between; align-items: flex-end; gap: 5mm; border-bottom: 1.2mm solid #d6a40b; padding-bottom: 3mm; margin-bottom: 6mm; }
    .event-heading { display: flex; align-items: center; gap: 5mm; min-width: 0; }
    .federation-logo { width: 65mm; max-width: 42%; height: auto; flex: 0 0 auto; }
    .event-titles { min-width: 0; }
    .event-header h1 { margin: 0; font-size: 21pt; color: #10254a; white-space: nowrap; }
    .event-header p { margin: 1mm 0 0; font-size: 11pt; font-weight: 700; color: #33415c; }
    .event-meta { text-align: right; font-size: 9pt; color: #536078; }
    .category { min-height: 119mm; border: 0.35mm solid #bcc6d7; border-radius: 3mm; padding: 5mm; margin-bottom: 6mm; break-inside: avoid; position: relative; overflow: hidden; }
    .category::after { content: ''; position: absolute; width: 45mm; height: 45mm; right: -22mm; top: -23mm; border-radius: 50%; background: #f4c430; opacity: .18; }
    .category-name { margin: 0 0 4mm; font-size: 20pt; color: #10254a; }
    .podiums { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); gap: 5mm; align-items: start; }
    .category.doubles .podiums { grid-template-columns: 1fr; }
    .category.doubles .name { overflow: visible; text-overflow: clip; white-space: normal; line-height: 1.25; }
    .podium { border-radius: 2.5mm; overflow: hidden; }
    .podium-a { border: 0.6mm solid #d6a40b; box-shadow: 0 1.5mm 4mm rgba(16,37,74,.12); }
    .podium-b { border: 0.35mm solid #9aa7ba; margin-top: 5mm; }
    .podium-title { display: flex; justify-content: space-between; align-items: center; padding: 2.2mm 3mm; font-weight: 700; }
    .podium-a .podium-title { background: #10254a; color: #fff; font-size: 13pt; }
    .podium-b .podium-title { background: #e9edf3; color: #33415c; font-size: 10pt; }
    .badge { padding: .6mm 1.5mm; border-radius: 1mm; background: #f4c430; color: #10254a; font-size: 8pt; }
    .places { padding: 2mm; background: #fff; }
    .place { display: grid; grid-template-columns: 13mm 1fr; gap: 2mm; align-items: center; border-bottom: 0.25mm solid #e1e5ec; padding: 2.2mm 1.5mm; }
    .place:last-child { border-bottom: 0; }
    .podium-a .place:first-child { min-height: 17mm; background: linear-gradient(90deg, #fff7d1, #fff); }
    .podium-a .place:first-child .name { font-size: 13pt; font-weight: 700; }
    .podium-b .place { padding-top: 1.5mm; padding-bottom: 1.5mm; }
    .rank { font-weight: 800; color: #10254a; text-align: center; }
    .podium-a .rank { font-size: 12pt; }
    .podium-b .rank, .podium-b .name { font-size: 8.5pt; }
    .name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .country { color: #6c778c; font-size: 7.5pt; margin-left: 1mm; }
    .pending { color: #a3aab6; font-style: italic; }
    .empty { padding: 20mm; text-align: center; color: #788397; }
    @media print {
      body { background: #fff; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
      .controls { display: none; }
      .page { margin: 0; width: auto; min-height: 0; }
    }
  </style>
</head>
<body>
  <div class="controls">
    <button type="button" onclick="window.print()"><%= tr('printHonor') %></button>
    <span style="margin-left:10px"><%= honor.length %> categories · 2 categories per pàgina</span>
  </div>

  <% if (!honor.length) { %><div class="empty">Encara no hi ha quadres eliminatoris.</div><% } %>

  <% for (let pageIndex = 0; pageIndex < honor.length; pageIndex += 2) { %>
    <main class="page">
      <header class="event-header">
        <div class="event-heading">
          <img class="federation-logo" src="/images/capcalera-fctt.png" alt="Federació Catalana de Tennis de Taula">
          <div class="event-titles">
            <h1><%= tr('honorBoard') %></h1>
            <p><%= competition.nom %></p>
          </div>
        </div>
        <div class="event-meta">
          <div><%= competition.lloc || '' %></div>
          <div><%= competition.data_inici ? new Date(competition.data_inici).toLocaleDateString('ca-ES', {timeZone:'UTC'}) : '' %></div>
        </div>
      </header>

      <% honor.slice(pageIndex, pageIndex + 2).forEach(category => {
           const isDoubles = /DB|DOBLES/i.test(category.name || '');
           const renderPlace = (rank, person) => ({ rank, person });
           const mainPlaces = category.main ? [
             renderPlace('1r', category.main.winner),
             renderPlace('2n', category.main.runnerUp),
             renderPlace('3r', category.main.thirds[0]),
             renderPlace('3r', category.main.thirds[1])
           ] : [];
           const consolationPlaces = category.consolation ? [
             renderPlace('1r', category.consolation.winner),
             renderPlace('2n', category.consolation.runnerUp),
             renderPlace('3r', category.consolation.thirdToChampion || category.consolation.thirds[0])
           ] : [];
      %>
        <section class="category <%= isDoubles ? 'doubles' : '' %>">
          <h2 class="category-name"><%= category.name %></h2>
          <div class="podiums">
            <div class="podium podium-a">
              <div class="podium-title"><span><%= tr('mainDraw') %></span><span class="badge"><%= tr('principal') %></span></div>
              <div class="places">
                <% mainPlaces.forEach(place => { %>
                  <div class="place">
                    <div class="rank"><%= place.rank %></div>
                    <div class="name <%= place.person ? '' : 'pending' %>">
                      <%= place.person ? place.person.name : tr('pending') %>
                      <% if (place.person?.country) { %><span class="country"><%= place.person.country %></span><% } %>
                    </div>
                  </div>
                <% }); %>
                <% if (!mainPlaces.length) { %><div class="place pending"><%= tr('unavailable') %></div><% } %>
              </div>
            </div>

            <% if (!isDoubles) { %><div class="podium podium-b">
              <div class="podium-title"><span><%= tr('consolationDraw') %></span><span><%= tr('consolation') %></span></div>
              <div class="places">
                <% consolationPlaces.forEach(place => { %>
                  <div class="place">
                    <div class="rank"><%= place.rank %></div>
                    <div class="name <%= place.person ? '' : 'pending' %>">
                      <%= place.person ? place.person.name : tr('pending') %>
                      <% if (place.person?.country) { %><span class="country"><%= place.person.country %></span><% } %>
                    </div>
                  </div>
                <% }); %>
                <% if (!consolationPlaces.length) { %><div class="place pending"><%= tr('unavailable') %></div><% } %>
              </div>
            </div><% } %>
          </div>
        </section>
      <% }); %>
    </main>
  <% } %>
</body>
</html>
