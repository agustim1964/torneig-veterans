<%- include('../partials/header', { title: 'Competicions' }) %>

<div class="mb-4">
  <h1>Competicions</h1>
  <p class="text-muted mb-0">Cada competició agrupa les seves categories, participants, grups i quadres.</p>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="row g-3">
      <% competitions.forEach(c => { %>
        <div class="col-md-6">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <h5 class="card-title"><%= c.nom %></h5>
              <% if (c.lloc) { %><div class="text-muted"><%= c.lloc %></div><% } %>
              <p class="mt-3"><strong><%= c.categories %></strong> categories</p>

              <form action="/competitions/<%= c.idcompeticio %>/config" method="post"
                    class="border rounded p-2 mb-3 bg-light">
                <div class="row g-2">
                  <div class="col-4">
                    <label class="form-label small">Grups (min)</label>
                    <input class="form-control form-control-sm"
                           type="number" min="1"
                           name="durada_partit_grups"
                           value="<%= c.config.durada_partit_grups %>">
                  </div>
                  <div class="col-4">
                    <label class="form-label small">Elim. (min)</label>
                    <input class="form-control form-control-sm"
                           type="number" min="1"
                           name="durada_partit_eliminatories"
                           value="<%= c.config.durada_partit_eliminatories %>">
                  </div>
                  <div class="col-4">
                    <label class="form-label small">Hora inici</label>
                    <input class="form-control form-control-sm"
                           type="time"
                           name="hora_inici"
                           value="<%= String(c.config.hora_inici || '09:00').substring(0,5) %>">
                  </div>
                </div>
                <button class="btn btn-sm btn-outline-primary mt-2 w-100">
                  Desar configuració
                </button>
              </form>

              <span class="badge <%= c.activa ? 'text-bg-success' : 'text-bg-secondary' %>">
                <%= c.activa ? 'Activa' : 'Inactiva' %>
              </span>
            </div>
            <div class="card-footer bg-white d-flex gap-2">
              <a class="btn btn-primary btn-sm"
                 href="/categories?competitionId=<%= c.idcompeticio %>">Gestionar</a> <a class="btn btn-outline-primary btn-sm" href="/schedule/competition/<%= c.idcompeticio %>">Màster horaris</a>
              <form action="/competitions/<%= c.idcompeticio %>/toggle" method="post">
                <button class="btn btn-outline-secondary btn-sm">
                  <%= c.activa ? 'Desactivar' : 'Activar' %>
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow-sm">
      <div class="card-header">Nova competició</div>
      <div class="card-body">
        <form action="/competitions" method="post">
          <div class="mb-3">
            <label class="form-label">Nom</label>
            <input class="form-control" name="nom" required>
          </div>
          <div class="row g-2">
            <div class="col-6 mb-3">
              <label class="form-label">Data inici</label>
              <input class="form-control" type="date" name="data_inici">
            </div>
            <div class="col-6 mb-3">
              <label class="form-label">Data fi</label>
              <input class="form-control" type="date" name="data_fi">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Lloc</label>
            <input class="form-control" name="lloc">
          </div>
          <div class="mb-3">
            <label class="form-label">Observacions</label>
            <textarea class="form-control" name="observacions"></textarea>
          </div>
          <button class="btn btn-primary w-100">Crear competició</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
