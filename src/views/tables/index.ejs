<%- include('../partials/header', { title: 'Taules' }) %>

<div class="mb-4">
  <h1>Gestió de taules</h1>
  <p class="text-muted mb-0">
    <strong><%= active %></strong> actives de <strong><%= total %></strong> creades.
  </p>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between">
        <span>Taules del torneig</span>
        <span class="badge text-bg-primary"><%= active %> actives</span>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th style="width:90px">Número</th>
              <th>Nom</th>
              <th>Observacions</th>
              <th>Estat</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
          <% tables.forEach(t => { %>
            <tr class="<%= t.activa ? '' : 'table-light text-muted' %>">
              <td>
                <form action="/tables/<%= t.idtaula %>/update" method="post">
                  <input class="form-control form-control-sm"
                         type="number" min="1" name="numero"
                         value="<%= t.numero %>" required>
              </td>
              <td>
                  <input class="form-control form-control-sm"
                         name="nom" value="<%= t.nom || '' %>">
              </td>
              <td>
                  <input class="form-control form-control-sm"
                         name="observacions"
                         value="<%= t.observacions || '' %>">
              </td>
              <td>
                <% if (t.activa) { %>
                  <span class="badge text-bg-success">Activa</span>
                <% } else { %>
                  <span class="badge text-bg-secondary">Inactiva</span>
                <% } %>
              </td>
              <td class="text-end text-nowrap">
                  <button class="btn btn-sm btn-outline-success">Desar</button>
                </form>

                <form action="/tables/<%= t.idtaula %>/toggle"
                      method="post" class="d-inline">
                  <button class="btn btn-sm btn-outline-secondary mt-1">
                    <%= t.activa ? 'Desactivar' : 'Activar' %>
                  </button>
                </form>

                <form action="/tables/<%= t.idtaula %>/delete"
                      method="post" class="d-inline"
                      onsubmit="return confirm('Eliminar definitivament aquesta taula?')">
                  <button class="btn btn-sm btn-outline-danger mt-1">Eliminar</button>
                </form>
              </td>
            </tr>
          <% }) %>

          <% if (!tables.length) { %>
            <tr>
              <td colspan="5" class="text-center text-muted py-4">
                Encara no hi ha taules creades.
              </td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow-sm mb-4 border-primary">
      <div class="card-header">Configurar nombre de taules</div>
      <div class="card-body">
        <p class="small text-muted">
          Si indiques 20, es creen o activen les taules 1 a 20.
          Les de número superior queden inactives, però no s'esborren.
        </p>

        <form action="/tables/configure-count" method="post">
          <div class="mb-3">
            <label class="form-label">Nombre de taules actives</label>
            <input class="form-control"
                   type="number" min="0" max="500"
                   name="count" value="<%= active %>" required>
          </div>
          <button class="btn btn-primary w-100">Configurar</button>
        </form>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-header">Crear una taula</div>
      <div class="card-body">
        <form action="/tables" method="post">
          <div class="mb-3">
            <label class="form-label">Número</label>
            <input class="form-control" type="number"
                   min="1" name="numero" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Nom</label>
            <input class="form-control" name="nom"
                   placeholder="Taula 21">
          </div>
          <div class="mb-3">
            <label class="form-label">Observacions</label>
            <input class="form-control" name="observacions">
          </div>
          <button class="btn btn-outline-primary w-100">Crear taula</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
