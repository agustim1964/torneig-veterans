<!doctype html>
<% const viewLocale = typeof locale !== 'undefined' ? locale : 'ca';
   const tr = typeof t !== 'undefined' ? t : key => key; %>
<html lang="<%= viewLocale %>">
<head>
  <meta charset="utf-8">
  <title><%= pageTitle %></title>
  <style>
    @page { size: A4 portrait; margin: 10mm; }
    * { box-sizing: border-box; }
    body { font-family: Arial, sans-serif; margin: 0; color: #111; }
    h1,h2,p { margin: 0 0 6px; }
    .controls {
      max-width: 190mm;
      margin: 12px auto;
      padding: 10px 12px;
      border: 1px solid #ccc;
      border-radius: 6px;
      background: #f7f7f7;
    }
    .controls button { padding: 6px 12px; cursor: pointer; }
    .sheet {
      max-width: 190mm;
      margin: 0 auto;
      break-after: page;
      page-break-after: always;
    }
    .sheet:last-child {
      break-after: auto;
      page-break-after: auto;
    }
    .capcalera-fctt {
      width: 100%;
      padding-bottom: 10px;
      margin-bottom: 14px;
      border-bottom: 1px solid #999;
    }
    .capcalera-fctt img {
      display: block;
      width: 100%;
      max-width: 490px;
      height: auto;
    }
    .titol-acta { margin-top: 4px; }
    .titol-acta h1 { font-size: 22px; margin-bottom: 4px; }
    .titol-acta h2 { font-size: 17px; font-weight: 600; }
    .meta {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      margin: 14px 0;
    }
    .box { border: 1px solid #999; padding: 7px; }
    table { width: 100%; border-collapse: collapse; margin-top: 14px; }
    th,td { border: 1px solid #777; padding: 6px; font-size: 12px; }
    th { background: #eee; }
    .games td { height: 28px; }
    .center { text-align: center; }
    .nowrap { white-space: nowrap; }
    .saved-score { font-weight: 700; }
    .classification {
      margin-top: 14px;
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .classification h3 { margin: 0 0 5px; font-size: 15px; }
    .classification table { margin-top: 0; }
    .classification .blank-row td { height: 25px; }
    .empty { max-width: 190mm; margin: 30px auto; text-align: center; }

    @media print {
      .controls { display: none; }
      .sheet { max-width: none; margin: 0; }
    }
  </style>
</head>
<body>
  <div class="controls">
    <button type="button" onclick="window.print()">🖨 <%= tr('print') %></button>
    <span style="margin-left:8px"><%= sheets.length %> · <%= tr('groups') %></span>
  </div>

  <% if (!sheets.length) { %>
    <div class="empty"><h1><%= tr('noGroups') %></h1></div>
  <% } %>

  <% sheets.forEach(sheet => {
       const group = sheet.group;
       const participants = sheet.participants;
       const matches = sheet.matches;
       const standings = sheet.standings || [];
       const bestOf = String(group.categoria_nom || '').toUpperCase() === 'PARKINSONDB' ? 3 : 5;
  %>
    <article class="sheet">
      <div class="capcalera-fctt">
        <img src="/images/capcalera-fctt.png" alt="Federació Catalana de Tennis de Taula">
      </div>

      <div class="titol-acta">
        <h1><%= group.competicio_nom %></h1>
        <h2>
          <%= group.categoria_nom %> ·
          <%= group.format_competicio === 'GRUP_UNIC'
            ? ('Top ' + participants.length + ' · Grup únic')
            : (tr('group') + ' ' + group.numero) %>
        </h2>
      </div>

      <div class="meta">
        <% const localeCode = {ca:'ca-ES',es:'es-ES',fr:'fr-FR',en:'en-GB',ru:'ru-RU'}[viewLocale] || 'ca-ES';
           const matchDays = [...new Set(matches.filter(m => m.data_hora).map(m => new Date(m.data_hora).toLocaleDateString(localeCode)))];
           const matchTables = [...new Set(matches.map(m => m.taula_numero).filter(Boolean))]; %>
        <div class="box"><strong><%= tr('dates') %></strong><br><%= matchDays.length ? matchDays.join(' · ') : (group.data ? new Date(group.data).toLocaleDateString(localeCode) : '—') %></div>
        <div class="box"><strong><%= tr('tables') %></strong><br><%= matchTables.length ? matchTables.join(', ') : (group.taula_numero || '—') %></div>
        <div class="box"><strong><%= tr('start') %></strong><br><%= group.hora_inici ? String(group.hora_inici).substring(0,5) : '—' %></div>
        <div class="box"><strong><%= tr('end') %></strong><br><%= group.hora_final ? String(group.hora_final).substring(0,5) : '—' %></div>
      </div>

      <table>
        <thead><tr><th><%= tr('position') %></th><th><%= tr('participant') %></th><th><%= tr('country') %></th><th><%= tr('club') %></th><th><%= tr('ranking') %></th></tr></thead>
        <tbody>
        <% participants.forEach(participant => { %>
          <tr>
            <td class="center"><%= participant.ordre_visual %></td>
            <td><%= participant.nom_mostrar %></td>
            <td class="center"><%= participant.pais || '' %></td>
            <td><%= participant.club || '' %></td>
            <td class="center"><%= participant.ranking %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>

      <table class="games">
        <thead>
          <tr>
            <% if (group.format_competicio === 'GRUP_UNIC' || group.mode_taules_grups === 'MAXIM') { %><th>Franja</th><% } %>
            <th><%= tr('date') %></th><th><%= tr('time') %></th><th><%= tr('table') %></th><th><%= tr('match') %></th><th><%= tr('referee') %></th>
            <% for (let gameNumber = 1; gameNumber <= bestOf; gameNumber++) { %>
              <th>J<%= gameNumber %></th>
            <% } %>
            <th><%= tr('result') %></th>
          </tr>
        </thead>
        <tbody>
        <% matches.forEach(match => { %>
          <tr>
            <% if (group.format_competicio === 'GRUP_UNIC' || group.mode_taules_grups === 'MAXIM') { %>
              <td class="center"><%= match.ronda_grup || '' %></td>
            <% } %>
            <td class="nowrap"><%= match.data_hora ? new Date(match.data_hora).toLocaleDateString('ca-ES', {day:'2-digit',month:'2-digit'}) : '' %></td>
            <td class="nowrap"><%= match.data_hora ? new Date(match.data_hora).toLocaleTimeString('ca-ES',{hour:'2-digit',minute:'2-digit'}) : '' %></td>
            <td class="center"><%= match.taula_numero || '' %></td>
            <td><%= match.participant1_nom %> — <%= match.participant2_nom %></td>
            <td><%= match.arbitre_nom || '' %></td>
            <% for (let gameNumber = 1; gameNumber <= bestOf; gameNumber++) {
                 const game = (match.jocs || []).find(item => Number(item.numero_joc) === gameNumber);
            %>
              <td class="center <%= game ? 'saved-score' : '' %>">
                <%= game ? (game.punts1 + '-' + game.punts2) : '' %>
              </td>
            <% } %>
            <td class="center saved-score">
              <%= match.resultat1 !== null && match.resultat2 !== null
                ? (match.resultat1 + '-' + match.resultat2)
                : '' %>
            </td>
          </tr>
        <% }) %>
        <% if (!matches.length) { %>
          <tr>
            <td colspan="<%= 6 + bestOf + ((group.format_competicio === 'GRUP_UNIC' || group.mode_taules_grups === 'MAXIM') ? 1 : 0) %>" class="center">
              Genera els partits des de “Partits i classificació” abans d’imprimir l’acta.
            </td>
          </tr>
        <% } %>
        </tbody>
      </table>

      <div class="classification">
        <h3><%= tr('classification') %><%= sheet.classificationFinal ? '' : ' *' %></h3>
        <table>
          <thead>
            <tr>
              <th><%= tr('position') %></th><th><%= tr('participant') %></th><th><%= tr('wins') %></th><th><%= tr('losses') %></th><th><%= tr('gamesRatio') %></th><th><%= tr('pointsRatio') %></th>
            </tr>
          </thead>
          <tbody>
          <% if (standings.length) { %>
            <% standings.forEach((row, index) => { %>
              <tr>
                <td class="center"><strong><%= index + 1 %></strong></td>
                <td><%= row.nom_mostrar %></td>
                <td class="center"><%= row.victories %></td>
                <td class="center"><%= row.derrotes %></td>
                <td class="center">
                  <%= row.factor_jocs === null || row.factor_jocs === undefined
                    ? ''
                    : (row.factor_jocs === Infinity ? '∞' : Number(row.factor_jocs).toFixed(3)) %>
                </td>
                <td class="center">
                  <%= row.factor_punts === null || row.factor_punts === undefined
                    ? ''
                    : (row.factor_punts === Infinity ? '∞' : Number(row.factor_punts).toFixed(3)) %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <% participants.forEach(() => { %>
              <tr class="blank-row">
                <td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td>
              </tr>
            <% }) %>
          <% } %>
          </tbody>
        </table>
      </div>

      <p style="margin-top:14px;font-size:11px">
        <%= tr('tieBreak') %>
      </p>
    </article>
  <% }) %>
</body>
</html>
