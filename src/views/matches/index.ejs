<%- include('../partials/header', { title: 'Partits - ' + category.nom }) %>

<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <a href="/groups/category/<%= category.idcategoria %>"
       class="text-decoration-none">← Grups</a>
    <h1 class="mt-2">Partits i classificació · <%= category.nom %></h1>
    <p class="text-muted"><%= category.competicio_nom %></p>
  </div>

  <form action="/matches/category/<%= category.idcategoria %>/generate-groups"
        method="post"
        onsubmit="return confirm('Generar partits només per als grups que encara no en tenen?')">
    <button class="btn btn-primary">
      Generar partits que falten
    </button>
  </form>
</div>


<div class="alert alert-secondary py-2">
  Aquest botó només genera els grups que encara no tenen partits.
  Per canviar participants d'un grup que ja té partits, utilitza els controls
  <strong>Reiniciar i regenerar partits</strong> des de la pantalla de grups.
</div>

<div class="card shadow-sm mb-4">
  <div class="card-header">Partits de grup</div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Data</th>
          <th>Hora</th>
          <th>Taula</th>
          <th><%= category.format_competicio === 'GRUP_UNIC' ? 'Format' : 'Grup' %></th>
          <% if (category.format_competicio === 'GRUP_UNIC') { %><th>Ronda</th><% } %>
          <th>Partit</th>
          <th>Àrbitre</th>
          <th>Resultat</th>
          <th>Estat</th>
        </tr>
      </thead>
      <tbody>
      <% matches.forEach(m => { %>
        <tr>
          <td>
            <%= m.data_hora ? new Date(m.data_hora).toLocaleDateString('ca-ES') : '' %>
          </td>
          <td>
            <%= m.data_hora
              ? new Date(m.data_hora).toLocaleTimeString('ca-ES', {hour:'2-digit', minute:'2-digit'})
              : '' %>
          </td>
          <td><%= m.taula_nom || ('Taula ' + (m.taula_numero || '')) %></td>
          <td><%= category.format_competicio === 'GRUP_UNIC' ? 'Top X' : ('Grup ' + m.grup_numero) %></td>
          <% if (category.format_competicio === 'GRUP_UNIC') { %>
            <td><strong>R<%= m.ronda_grup || '' %></strong></td>
          <% } %>
          <td>
            <strong><%= m.participant1_nom %></strong>
            <span class="text-muted"> vs </span>
            <strong><%= m.participant2_nom %></strong>
          </td>
          <td><%= m.arbitre_nom || '' %></td>
          <td style="min-width:440px">
            <form action="/matches/<%= m.idpartit %>/result"
                  method="post"
                  class="d-flex flex-wrap gap-1 align-items-center match-result-form"
                  data-match-id="<%= m.idpartit %>">
              <input type="hidden" name="categoryId" value="<%= category.idcategoria %>">

              <% for (let joc = 1; joc <= 5; joc++) {
                   const saved = (m.jocs || []).find(x => Number(x.numero_joc) === joc);
              %>
                <div class="d-flex align-items-center gap-1 border rounded px-1 py-1">
                  <span class="small text-muted">J<%= joc %></span>
                  <input class="form-control form-control-sm text-center game-score"
                         style="width:48px"
                         type="number" min="0" max="99"
                         inputmode="numeric"
                         data-game="<%= joc %>"
                         data-player="1"
                         name="joc<%= joc %>_p1"
                         value="<%= saved ? saved.punts1 : '' %>">
                  <span>-</span>
                  <input class="form-control form-control-sm text-center game-score"
                         style="width:48px"
                         type="number" min="0" max="99"
                         inputmode="numeric"
                         data-game="<%= joc %>"
                         data-player="2"
                         name="joc<%= joc %>_p2"
                         value="<%= saved ? saved.punts2 : '' %>">
                </div>
              <% } %>

              <button class="btn btn-sm btn-outline-success save-result">Desar</button>

              <strong class="ms-1 match-summary">
                <% if (m.resultat1 !== null && m.resultat2 !== null) { %>
                  <%= m.resultat1 %>-<%= m.resultat2 %>
                <% } %>
              </strong>
            </form>
          </td>
          <td>
            <% if (m.estat === 'FINALITZAT') { %>
              <span class="badge text-bg-success">Finalitzat</span>
            <% } else { %>
              <span class="badge text-bg-secondary"><%= m.estat %></span>
            <% } %>
          </td>
        </tr>
      <% }) %>

      <% if (!matches.length) { %>
        <tr>
          <td colspan="8" class="text-center text-muted py-4">
            Encara no s'han generat els partits.
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>

<h2 class="mb-3">
  <% if (category.format_competicio === 'GRUP_UNIC') { %>
    <%= topXComplete ? 'Classificació final' : 'Classificació provisional del Top X' %>
  <% } else { %>
    Classificació provisional
  <% } %>
</h2>

<div class="row g-4">
  <% Object.values(groupedStandings).forEach(rows => { %>
    <div class="col-md-6 col-xl-4">
      <div class="card shadow-sm h-100">
        <div class="card-header">
          <strong>
            <%= category.format_competicio === 'GRUP_UNIC'
              ? ('Top ' + rows.length)
              : ('Grup ' + rows[0]?.grup_numero) %>
          </strong>
          <% if (category.format_competicio === 'GRUP_UNIC' && topXComplete) { %>
            <span class="badge text-bg-success ms-2">FINAL</span>
          <% } %>
        </div>

        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead>
              <tr>
                <th>Pos.</th>
                <th>Participant</th>
                <th>V</th>
                <th>D</th>
                <th>F. jocs</th>
                <th>F. punts</th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach((r, index) => { %>
                <tr>
                  <td><strong><%= index + 1 %></strong></td>
                  <td><%= r.nom_mostrar %></td>
                  <td><%= r.victories %></td>
                  <td><%= r.derrotes %></td>
                  <td>
                    <%= r.factor_jocs === null || r.factor_jocs === undefined
                      ? ''
                      : (r.factor_jocs === Infinity ? '∞' : Number(r.factor_jocs).toFixed(3)) %>
                  </td>
                  <td>
                    <%= r.factor_punts === null || r.factor_punts === undefined
                      ? ''
                      : (r.factor_punts === Infinity ? '∞' : Number(r.factor_punts).toFixed(3)) %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<div class="alert alert-info mt-4">
  <% if (category.format_competicio === 'GRUP_UNIC') { %>
    <strong>Top X:</strong> aquesta classificació és la classificació final quan s'hagin disputat tots els partits.
    No hi ha Final A ni Consolació.
    <br>
  <% } %>
  En cas d'empat a victòries, només es tenen en compte els partits disputats
  entre els participants empatats. Primer s'aplica el factor
  <strong>jocs guanyats / jocs perduts</strong> i, si continua l'empat,
  el factor <strong>punts guanyats / punts perduts</strong>.
</div>


<script>
(function () {
  const forms = document.querySelectorAll('.match-result-form');

  function readGame(form, game) {
    const a = form.querySelector(`[data-game="${game}"][data-player="1"]`);
    const b = form.querySelector(`[data-game="${game}"][data-player="2"]`);
    const va = a.value === '' ? null : Number(a.value);
    const vb = b.value === '' ? null : Number(b.value);
    return { a, b, va, vb };
  }

  function completedScore(form) {
    let wins1 = 0;
    let wins2 = 0;
    let clinchGame = null;

    for (let game = 1; game <= 5; game++) {
      const { va, vb } = readGame(form, game);
      if (va === null || vb === null || va === vb) continue;

      if (va > vb) wins1++;
      else wins2++;

      if ((wins1 === 3 || wins2 === 3) && clinchGame === null) {
        clinchGame = game;
        break;
      }
    }

    return { wins1, wins2, clinchGame };
  }

  function refreshForm(form) {
    const { wins1, wins2, clinchGame } = completedScore(form);
    const summary = form.querySelector('.match-summary');

    for (let game = 1; game <= 5; game++) {
      const { a, b } = readGame(form, game);
      const afterMatch = clinchGame !== null && game > clinchGame;

      if (afterMatch) {
        a.value = '';
        b.value = '';
        a.disabled = true;
        b.disabled = true;
      } else {
        a.disabled = false;
        b.disabled = false;
      }
    }

    summary.textContent = clinchGame !== null ? `${wins1}-${wins2}` : '';

    return { wins1, wins2, clinchGame };
  }

  function focusNextGame(form, currentGame) {
    const nextGame = currentGame + 1;
    if (nextGame > 5) return;

    const next = form.querySelector(
      `[data-game="${nextGame}"][data-player="1"]:not(:disabled)`
    );
    if (next) {
      next.focus();
      next.select();
    }
  }


  function isValidFinishedGame(a, b) {
    if (a === null || b === null) return false;
    if (!Number.isInteger(a) || !Number.isInteger(b)) return false;
    if (a < 0 || b < 0 || a === b) return false;

    const winner = Math.max(a, b);
    const loser = Math.min(a, b);

    if (loser <= 9) {
      return winner === 11;
    }

    return winner >= 12 && (winner - loser === 2);
  }

  function markGameValidity(form, game) {
    const { a, b, va, vb } = readGame(form, game);

    a.classList.remove('is-invalid');
    b.classList.remove('is-invalid');

    if (va === null || vb === null) return null;

    const valid = isValidFinishedGame(va, vb);

    if (!valid) {
      a.classList.add('is-invalid');
      b.classList.add('is-invalid');
    }

    return valid;
  }

  forms.forEach(form => {
    let internalFocusMove = false;

    refreshForm(form);

    function moveFocus(target) {
      if (!target || target.disabled) return;
      internalFocusMove = true;
      target.focus();
      target.select();
      setTimeout(() => { internalFocusMove = false; }, 0);
    }

    function confirmEntry(field, source) {
      if (!field || field.disabled || field.value === '') return;

      const game = Number(field.dataset.game);
      const player = Number(field.dataset.player);
      const value = Number(field.value);

      if (!Number.isInteger(value) || value < 0) {
        field.classList.add('is-invalid');
        return;
      }

      const otherPlayer = player === 1 ? 2 : 1;
      const other = form.querySelector(
        `[data-game="${game}"][data-player="${otherPlayer}"]`
      );

      // Entrada ràpida: 0..9 representa la puntuació del perdedor.
      if (value <= 9) {
        other.value = 11;
      }

      const current = readGame(form, game);

      // Amb 10 o més hem d'entrar l'altre marcador manualment.
      if (current.va === null || current.vb === null) {
        if (source === 'enter') moveFocus(other);
        return;
      }

      if (!isValidFinishedGame(current.va, current.vb)) {
        markGameValidity(form, game);
        // Amb Enter retenim el focus per corregir; amb blur no robem
        // el focus que l'usuari acaba de seleccionar.
        if (source === 'enter') moveFocus(field);
        return;
      }

      markGameValidity(form, game);
      const state = refreshForm(form);

      if (state.clinchGame === game) {
        form.requestSubmit();
        return;
      }

      const nextGame = game + 1;
      const next = nextGame <= 5
        ? form.querySelector(`[data-game="${nextGame}"][data-player="1"]:not(:disabled)`)
        : null;

      // Tant amb Enter com en perdre el focus, si el joc ja és complet
      // el cursor salta al primer camp del joc següent.
      if (next) moveFocus(next);
    }

    form.querySelectorAll('.game-score').forEach(input => {
      input.addEventListener('input', function () {
        const game = Number(this.dataset.game);
        const pair = readGame(form, game);
        pair.a.classList.remove('is-invalid');
        pair.b.classList.remove('is-invalid');
        refreshForm(form);
      });

      input.addEventListener('keydown', function (event) {
        if (event.key !== 'Enter') return;
        event.preventDefault();
        confirmEntry(this, 'enter');
      });

      input.addEventListener('blur', function () {
        if (internalFocusMove) return;

        const field = this;
        // Deixem acabar el canvi de focus que ha fet l'usuari i després
        // apliquem l'entrada ràpida. Ex.: 9 + clic fora => 9-11 i focus
        // al joc següent.
        setTimeout(() => confirmEntry(field, 'blur'), 0);
      });

      input.addEventListener('focus', function () {
        this.select();
      });
    });
  });
})();
</script>

<%- include('../partials/footer') %>
