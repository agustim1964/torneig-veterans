<!doctype html><html lang="ca"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Accés · Torneig Veterans</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/app.css" rel="stylesheet"></head>
<body class="bg-light"><main class="container py-5" style="max-width:460px"><div class="card shadow-sm border-0 mt-lg-5"><div class="card-body p-4 p-md-5">
<img src="/images/capcalera-fctt.png" alt="Federació Catalana de Tennis de Taula" class="img-fluid mb-4"><h1 class="h3 mb-2">Accés al campionat</h1><p class="text-muted mb-4">Introdueix l’usuari i la contrasenya.</p>
<% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %><form method="post" action="/login" autocomplete="on"><input type="hidden" name="returnTo" value="<%= returnTo||'/competitions' %>">
<div class="mb-3"><label class="form-label" for="username">Usuari</label><input class="form-control" id="username" name="username" autocomplete="username" required autofocus></div>
<div class="mb-4"><label class="form-label" for="password">Contrasenya</label><input class="form-control" type="password" id="password" name="password" autocomplete="current-password" required></div>
<button class="btn btn-primary w-100" type="submit">Entrar</button></form></div></div></main></body></html>
