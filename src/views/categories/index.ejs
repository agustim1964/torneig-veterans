<%- include('../partials/header', { title: 'Categories' }) %>

<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <a href="/competitions" class="text-decoration-none">← Competicions</a>
    <h1 class="mt-2">Categories</h1>
    <% if (competition) { %><p class="text-muted"><%= competition.nom %></p><% } %>
  </div>
  <div class="d-flex gap-2 align-items-start">
    <% if (competition) { %>
      <a class="btn btn-outline-primary"
         href="/competitions/<%= competition.idcompeticio %>/participants">
        Llistat participants
      </a>
    <% } %>
    <% if (competitions.length > 1) { %>
      <form method="get">
        <select class="form-select" name="competitionId" onchange="this.form.submit()">
          <% competitions.forEach(c => { %>
            <option value="<%= c.idcompeticio %>"
              <%= Number(c.idcompeticio) === Number(competitionId) ? 'selected' : '' %>>
              <%= c.nom %>
            </option>
          <% }) %>
        </select>
      </form>
    <% } %>
  </div>
</div>

<% if (competition) { %>
  <div class="card shadow-sm mb-4">
    <div class="card-header">Resum general per preparar el màster</div>
    <div class="card-body">
      <p class="small text-muted mb-0">Participants actius i grups del sorteig actual.
        En dobles es compten parelles. Els totals són inscripcions per categoria, no jugadors únics.
        Els partits de grup són els previstos en un tots contra tots, sense eliminatòries.</p>
    </div>
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead>
          <tr>
            <th scope="col">Categoria</th>
            <th scope="col" class="text-end">Participants actius</th>
            <% summary.sizes.forEach(size => { %>
              <th scope="col" class="text-end text-nowrap">Grups de <%= size %></th>
            <% }) %>
            <th scope="col" class="text-end">Total grups</th>
            <th scope="col" class="text-end">Participants als grups</th>
            <th scope="col" class="text-end">Partits de grup</th>
          </tr>
        </thead>
        <tbody>
          <% summary.rows.forEach(row => { %>
            <tr>
              <th scope="row">
                <a href="/groups/category/<%= row.idcategoria %>"><%= row.nom %></a>
                <% if (!row.groupCount) { %><span class="badge text-bg-secondary">Sense sorteig</span><% } %>
                <% if (row.groupCount && row.groupedParticipants !== row.participants) { %>
                  <span class="badge text-bg-warning">Revisar participants</span>
                <% } %>
              </th>
              <td class="text-end"><%= row.participants %></td>
              <% summary.sizes.forEach(size => { %>
                <td class="text-end"><%= row.sizes[size] || 0 %></td>
              <% }) %>
              <td class="text-end"><%= row.groupCount %></td>
              <td class="text-end"><%= row.groupedParticipants %></td>
              <td class="text-end"><%= row.matches %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot class="table-light fw-bold">
          <tr>
            <th scope="row">Total competició</th>
            <td class="text-end"><%= summary.totals.participants %></td>
            <% summary.sizes.forEach(size => { %>
              <td class="text-end"><%= summary.totals.sizes[size] || 0 %></td>
            <% }) %>
            <td class="text-end"><%= summary.totals.groupCount %></td>
            <td class="text-end"><%= summary.totals.groupedParticipants %></td>
            <td class="text-end"><%= summary.totals.matches %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
<% } %>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="row g-3">
      <% categories.forEach(category => { %>
        <div class="col-md-6">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <h5><%= category.nom %></h5>
              <div class="small text-muted mb-3">
                <%= category.tipus %> · <%= category.sexe %>
                <% if (category.edat_minima) { %> · +<%= category.edat_minima %><% } %>
              </div>
              <p><strong><%= category.participants %></strong> participants actius</p>
              <div class="d-flex gap-2 flex-wrap mb-3">
                <span class="badge text-bg-secondary"><%= category.estat %></span>
                <% if (category.format_competicio === 'GRUP_UNIC') { %>
                  <span class="badge text-bg-success">Top X / grup únic</span>
                <% } else if (category.format_competicio === 'GRUPS_MES_FINAL') { %>
                  <span class="badge text-bg-primary">Grups + eliminatòries</span>
                <% } else { %>
                  <span class="badge text-bg-light border text-dark">Format automàtic</span>
                <% } %>
              </div>

              <form action="/categories/<%= category.idcategoria %>/format" method="post"
                    onsubmit="return confirm('Canviar el format eliminarà el sorteig actual si encara no hi ha partits. Continuar?')">
                <label class="form-label small mb-1">Format</label>
                <div class="input-group input-group-sm">
                  <select class="form-select" name="format_competicio">
                    <option value="AUTO" <%= category.format_competicio === 'AUTO' ? 'selected' : '' %>>Automàtic</option>
                    <option value="GRUPS_MES_FINAL" <%= category.format_competicio === 'GRUPS_MES_FINAL' ? 'selected' : '' %>>Grups + eliminatòries</option>
                    <option value="GRUP_UNIC" <%= category.format_competicio === 'GRUP_UNIC' ? 'selected' : '' %>>Top X / grup únic</option>
                  </select>
                  <button class="btn btn-outline-secondary">Canviar</button>
                </div>
              </form>

              <% if (category.format_competicio !== 'GRUP_UNIC') { %>
                <form action="/categories/<%= category.idcategoria %>/table-mode" method="post" class="mt-3">
                  <label class="form-label small mb-1">Taules fase de grups</label>
                  <div class="input-group input-group-sm">
                    <select class="form-select" name="mode_taules_grups">
                      <option value="UNA_PER_GRUP" <%= category.mode_taules_grups !== 'MAXIM' ? 'selected' : '' %>>
                        1 taula per grup
                      </option>
                      <option value="MAXIM" <%= category.mode_taules_grups === 'MAXIM' ? 'selected' : '' %>>
                        Màxim possible
                      </option>
                    </select>
                    <button class="btn btn-outline-secondary">Desar</button>
                  </div>
                  <div class="form-text">
                    En mode màxim, un grup de 4 utilitza 2 taules simultànies i disputa 3 franges.
                  </div>
                </form>
              <% } %>
            </div>
            <div class="card-footer bg-white d-flex gap-2">
              <a class="btn btn-primary btn-sm"
                 href="/participants/category/<%= category.idcategoria %>">Participants</a>
              <a class="btn btn-outline-primary btn-sm"
                 href="/groups/category/<%= category.idcategoria %>">Grups</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="col-lg-4">
    <% if (competition) { %>
    <div class="card shadow-sm">
      <div class="card-header">Nova categoria</div>
      <div class="card-body">
        <form action="/categories" method="post">
          <input type="hidden" name="idcompeticio" value="<%= competition.idcompeticio %>">
          <div class="mb-3">
            <label class="form-label">Nom</label>
            <input class="form-control" name="nom" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Tipus</label>
            <select class="form-select" name="tipus">
              <option value="INDIVIDUAL">Individual</option>
              <option value="DOBLES">Dobles</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Sexe</label>
            <select class="form-select" name="sexe">
              <option value="MASCULI">Masculí</option>
              <option value="FEMENI">Femení</option>
              <option value="MIXT">Mixt</option>
              <option value="OBERT">Obert</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Edat mínima</label>
            <input class="form-control" type="number" name="edat_minima">
          </div>
          <div class="mb-3">
            <label class="form-label">Format de competició</label>
            <select class="form-select" name="format_competicio">
              <option value="AUTO">Automàtic</option>
              <option value="GRUPS_MES_FINAL">Grups + eliminatòries</option>
              <option value="GRUP_UNIC">Top X / grup únic</option>
            </select>
            <div class="form-text">
              Top X crea un únic grup, tots contra tots, i la classificació del grup és la classificació final.
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Taules fase de grups</label>
            <select class="form-select" name="mode_taules_grups">
              <option value="UNA_PER_GRUP">1 taula per grup</option>
              <option value="MAXIM">Màxim possible</option>
            </select>
            <div class="form-text">
              S'aplica als grups normals. Els Top X ja utilitzen automàticament floor(X/2) taules.
            </div>
          </div>
          <button class="btn btn-primary w-100">Crear categoria</button>
        </form>
      </div>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
