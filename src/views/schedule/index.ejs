<%- include('../partials/header',{title:'Màster - '+competition.nom}) %><div class="d-flex justify-content-between mb-4"><div><a href="/competitions">← Competicions</a><h1>Màster general d'horaris</h1></div><form action="/schedule/competition/<%= competition.idcompeticio %>/generate" method="post"><button class="btn btn-primary">Generar planificació automàtica</button></form></div><div class="alert alert-info">Una taula fixa per grup. Els grups bloquejats no es recalculen.</div><table class="table"><thead><tr><th>Categoria</th><th>Grup</th><th>Jug.</th><th>Taula</th><th>Inici</th><th>Final</th><th>Durada</th><th>Bloq.</th><th></th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%=r.categoria_nom%></td><td><%=r.grup_numero%></td><td><%=r.participants_grup%></td><form action="/schedule/<%=r.idprogramacio%>/update" method="post"><input type="hidden" name="competitionId" value="<%=competition.idcompeticio%>"><td><select name="idtaula" class="form-select"><% tables.forEach(t=>{ %><option value="<%=t.idtaula%>" <%=Number(t.idtaula)===Number(r.idtaula)?'selected':''%>><%=t.nom||('Taula '+t.numero)%></option><% }) %></select></td><td><input type="time" name="hora_inici" value="<%=String(r.hora_inici).substring(0,5)%>" class="form-control"></td><td><input type="time" name="hora_final" value="<%=String(r.hora_final).substring(0,5)%>" class="form-control"></td><td><%=r.durada_partit%> min</td><td><input type="checkbox" name="bloquejada" value="1" <%=r.bloquejada?'checked':''%>></td><td><button class="btn btn-sm btn-outline-success">Desar</button></td></form></tr><% }) %></tbody></table><%- include('../partials/footer') %>