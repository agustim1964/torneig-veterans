<%- include('../partials/header', { title: 'Màster - ' + competition.nom }) %>

<div class="d-flex justify-content-between align-items-start mb-4 gap-3">
  <div>
    <a href="/competitions" class="text-decoration-none">← Competicions</a>
    <h1 class="mt-2">Màster general d'horaris</h1>
    <p class="text-muted mb-0"><%= competition.nom %></p>
  </div>

  <div class="d-flex gap-2 align-items-end flex-wrap justify-content-end">
    <a class="btn btn-outline-secondary"
       target="_blank"
       href="/schedule/competition/<%= competition.idcompeticio %>/print">
      Imprimir màster
    </a>

    <form action="/schedule/competition/<%= competition.idcompeticio %>/generate" method="post"
          class="d-flex gap-2 align-items-end"
          onsubmit="return confirm('Recalcular els grups no bloquejats?')">
    <div>
      <label class="form-label small">Data per planificació automàtica</label>
      <input class="form-control" type="date" name="data" value="<%= defaultDate %>" required>
    </div>
      <button class="btn btn-outline-primary" name="mode" value="dia">Planificar aquest dia</button>
      <button class="btn btn-primary" name="mode" value="global"
              title="Distribueix automàticament totes les categories entre els dies i taules disponibles">
        Generar màster global
      </button>
    </form>
  </div>
</div>


<div class="card shadow-sm mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <strong>Sessions / jornades</strong>
    <span class="text-muted small">El màster global utilitza aquestes franges si n'hi ha definides.</span>
  </div>
  <div class="card-body">
    <% if (sessions.length) { %>
      <div class="table-responsive mb-3">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr>
              <th>Nom</th><th>Data</th><th>Inici</th><th>Final</th><th>Taules</th><th>Activa</th><th></th>
            </tr>
          </thead>
          <tbody>
          <% sessions.forEach(sessio => { %>
            <tr>
              <td colspan="7" class="p-0 border-0">
                <form action="/schedule/session/<%= sessio.idsessio %>/update" method="post"
                      class="d-grid gap-2 align-items-center py-1"
                      style="grid-template-columns: 1.4fr 1fr .7fr .7fr .6fr .45fr auto auto;">
                  <input type="hidden" name="competitionId" value="<%= competition.idcompeticio %>">
                  <input class="form-control form-control-sm" name="nom" value="<%= sessio.nom %>">
                  <input class="form-control form-control-sm" type="date" name="data" value="<%= isoDate(sessio.data) %>" required>
                  <input class="form-control form-control-sm" type="time" name="hora_inici" value="<%= String(sessio.hora_inici).substring(0,5) %>" required>
                  <input class="form-control form-control-sm" type="time" name="hora_final" value="<%= String(sessio.hora_final).substring(0,5) %>" required>
                  <input class="form-control form-control-sm" type="number" min="1" max="<%= competition.nombre_taules_disponibles || 1 %>" name="nombre_taules" value="<%= sessio.nombre_taules %>">
                  <div class="text-center"><input class="form-check-input" type="checkbox" name="activa" value="1" <%= sessio.activa ? 'checked' : '' %>></div>
                  <button class="btn btn-sm btn-outline-success">Desar</button>
                </form>
                <form action="/schedule/session/<%= sessio.idsessio %>/delete" method="post"
                      class="d-inline"
                      onsubmit="return confirm('Eliminar aquesta sessió?')">
                  <input type="hidden" name="competitionId" value="<%= competition.idcompeticio %>">
                  <button class="btn btn-sm btn-outline-danger mb-1">Eliminar</button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="alert alert-warning py-2">
        Encara no hi ha sessions. El màster global continuarà usant l'horari general de la competició fins que en defineixis alguna.
      </div>
    <% } %>

    <form action="/schedule/competition/<%= competition.idcompeticio %>/sessions" method="post"
          class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small">Nom</label>
        <input class="form-control form-control-sm" name="nom" placeholder="Matí / Tarda / Jornada 1" required>
      </div>
      <div class="col-md-2">
        <label class="form-label small">Data</label>
        <input class="form-control form-control-sm" type="date" name="data" value="<%= defaultDate %>" required>
      </div>
      <div class="col-md-2">
        <label class="form-label small">Inici</label>
        <input class="form-control form-control-sm" type="time" name="hora_inici" value="09:00" required>
      </div>
      <div class="col-md-2">
        <label class="form-label small">Final</label>
        <input class="form-control form-control-sm" type="time" name="hora_final" value="14:00" required>
      </div>
      <div class="col-md-1">
        <label class="form-label small">Taules</label>
        <input class="form-control form-control-sm" type="number" min="1" max="<%= competition.nombre_taules_disponibles || 1 %>" name="nombre_taules" value="<%= competition.nombre_taules_disponibles || 1 %>" required>
      </div>
      <div class="col-md-2">
        <button class="btn btn-sm btn-outline-primary w-100">Afegir sessió</button>
      </div>
    </form>
  </div>
</div>

<div class="alert alert-info">
  Els grups normals poden estar configurats com <strong>1 taula per grup</strong> o <strong>màxim possible</strong>.
  En mode màxim utilitzen ⌊X/2⌋ taules simultànies. Un <strong>Top X</strong> també ocupa automàticament ⌊X/2⌋ taules a cada ronda.
  <strong>Generar màster global</strong> distribueix automàticament totes les categories no bloquejades. Si hi ha sessions definides, respecta les seves dates, hores i nombre de taules; si no, utilitza l'horari general de la competició.
  Els blocs bloquejats es conserven.
</div>

<% if (dates.length) { %>
  <div class="mb-3 d-flex flex-wrap gap-2">
    <% dates.forEach(d => { %>
      <span class="badge text-bg-secondary fs-6"><%= new Date(d + 'T12:00:00').toLocaleDateString('ca-ES') %></span>
    <% }) %>
  </div>
<% } %>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Data</th>
          <th>Categoria</th>
          <th>Grup</th>
          <th>Jug.</th>
          <th>Taula</th>
          <th>Inici</th>
          <th>Final</th>
          <th>Durada</th>
          <th>Bloq.</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      <% rows.forEach(r => { %>
        <tr>
          <form action="/schedule/<%= r.idprogramacio %>/update" method="post">
            <input type="hidden" name="competitionId" value="<%= competition.idcompeticio %>">
            <td style="min-width:150px">
              <input class="form-control form-control-sm" type="date" name="data" value="<%= isoDate(r.data) %>" required>
            </td>
            <td><%= r.categoria_nom %></td>
            <td><%= r.format_competicio === 'GRUP_UNIC' ? 'Top X' : ('Grup ' + r.grup_numero) %></td>
            <td><%= r.participants_grup %></td>
            <td style="min-width:125px">
              <% if (r.format_competicio === 'GRUP_UNIC' || r.mode_taules_grups === 'MAXIM') { %>
                <span class="badge <%= r.format_competicio === 'GRUP_UNIC' ? 'text-bg-success' : 'text-bg-primary' %>">
                  Taules <%= r.taules_numeros || r.taula_numero %>
                </span>
                <div class="small text-muted mt-1">
                  <%= r.format_competicio === 'GRUP_UNIC' ? 'Top X per rondes' : 'Grup en paral·lel' %>
                </div>
              <% } else { %>
                <select name="idtaula" class="form-select form-select-sm">
                  <% tables.forEach(t => { %>
                    <option value="<%= t.idtaula %>" <%= Number(t.idtaula) === Number(r.idtaula) ? 'selected' : '' %>>
                      <%= t.nom || ('Taula ' + t.numero) %>
                    </option>
                  <% }) %>
                </select>
              <% } %>
            </td>
            <td><input class="form-control form-control-sm" type="time" name="hora_inici" value="<%= String(r.hora_inici).substring(0,5) %>"></td>
            <td><input class="form-control form-control-sm" type="time" name="hora_final" value="<%= String(r.hora_final).substring(0,5) %>"></td>
            <td><%= r.durada_partit %> min</td>
            <td class="text-center">
              <input class="form-check-input" type="checkbox" name="bloquejada" value="1" <%= r.bloquejada ? 'checked' : '' %>>
            </td>
            <td><button class="btn btn-sm btn-outline-success">Desar</button></td>
          </form>
        </tr>
      <% }) %>

      <% if (!rows.length) { %>
        <tr><td colspan="10" class="text-center text-muted py-4">Encara no hi ha cap grup programat.</td></tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
