<!doctype html>
<html lang="ca">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'Torneig Veterans' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<% const signedInUser = typeof currentUser !== 'undefined' ? currentUser : null; %>
<body class="<%= signedInUser?.role === 'guest' ? 'read-only' : '' %>">
<%
  const currentCompetitionId =
    (typeof competitionId !== 'undefined' && Number(competitionId)) ||
    (typeof competition !== 'undefined' && competition && Number(competition.idcompeticio)) ||
    (typeof category !== 'undefined' && category && Number(category.idcompeticio)) ||
    0;
  const categoriesUrl = currentCompetitionId
    ? `/categories?competitionId=${currentCompetitionId}`
    : '/categories';
%>
<nav class="navbar navbar-expand-lg bg-dark navbar-dark mb-4">
  <div class="container">
    <a class="navbar-brand" href="/competitions">Torneig Veterans</a>
    <div class="navbar-nav">
      <a class="nav-link" href="/competitions">Competicions</a>
      <a class="nav-link" href="<%= categoriesUrl %>">Categories</a>
      <% if (signedInUser?.role === 'admin') { %><a class="nav-link" href="/tables">Taules</a><% } %>
    </div>
    <div class="ms-auto d-flex align-items-center gap-2 text-white"><span class="small"><%= signedInUser?.username||'' %><%= signedInUser?.role==='guest'?' · consulta':'' %></span><form method="post" action="/logout" class="m-0 logout-form"><button class="btn btn-sm btn-outline-light" type="submit">Sortir</button></form></div>
  </div>
</nav>
<div class="container pb-5">
