<!doctype html>
<% const viewLocale = typeof locale !== 'undefined' ? locale : 'ca';
   const translate = typeof t !== 'undefined' ? t : key => key; %>
<html lang="<%= viewLocale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'Torneig Veterans' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<% const signedInUser = typeof currentUser !== 'undefined' ? currentUser : null; %>
<body class="<%= signedInUser?.role === 'guest' ? 'read-only' : '' %>">
<%
  const currentCompetitionId =
    (typeof competitionId !== 'undefined' && Number(competitionId)) ||
    (typeof competition !== 'undefined' && competition && Number(competition.idcompeticio)) ||
    (typeof category !== 'undefined' && category && Number(category.idcompeticio)) ||
    0;
  const categoriesUrl = currentCompetitionId
    ? `/categories?competitionId=${currentCompetitionId}`
    : '/categories';
%>
<nav class="navbar navbar-expand-lg bg-dark navbar-dark mb-4">
  <div class="container">
    <a class="navbar-brand" href="/competitions"><%= translate('appName') %></a>
    <div class="navbar-nav">
      <a class="nav-link" href="/competitions"><%= translate('competitions') %></a>
      <a class="nav-link" href="<%= categoriesUrl %>"><%= translate('categories') %></a>
      <% if (signedInUser?.role === 'admin') { %><a class="nav-link" href="/tables"><%= translate('tables') %></a><% } %>
    </div>
    <div class="ms-auto d-flex align-items-center gap-2 text-white">
      <form method="post" action="/language" class="m-0 language-form"><input type="hidden" name="returnTo" value="<%= typeof requestUrl !== 'undefined' ? requestUrl : '/competitions' %>"><select class="form-select form-select-sm" name="locale" onchange="this.form.submit()" aria-label="<%= translate('language') %>"><% [['ca','CA'],['es','ES'],['fr','FR'],['en','EN'],['pt','PT'],['ru','RU']].forEach(([code,label])=>{ %><option value="<%= code %>" <%= viewLocale===code?'selected':'' %>><%= label %></option><% }) %></select></form>
      <span class="small"><%= signedInUser?.username || '' %><%= signedInUser?.role === 'guest' ? ' · '+translate('consultation') : '' %></span>
      <form method="post" action="/logout" class="m-0 logout-form"><button class="btn btn-sm btn-outline-light" type="submit"><%= translate('signOut') %></button></form>
    </div>
  </div>
</nav>
<div class="container pb-5">
